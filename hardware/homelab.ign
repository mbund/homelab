{
  "ignition": {
    "version": "3.5.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "sudo"
        ],
        "name": "mbund",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM2kbXZV9yOofK3s37lz5DDogOIp9EKuUxaOhVdczKDr"
        ]
      }
    ]
  },
  "storage": {
    "disks": [
      {
        "device": "/dev/disk/by-id/coreos-boot-disk",
        "partitions": [
          {
            "label": "root",
            "number": 4,
            "resize": true,
            "sizeMiB": 32768
          },
          {
            "label": "data",
            "sizeMiB": 0
          }
        ],
        "wipeTable": false
      }
    ],
    "files": [
      {
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,homelab"
        },
        "mode": 420
      },
      {
        "path": "/etc/sudoers.d/mbund",
        "contents": {
          "compression": "",
          "source": "data:,mbund%20ALL%3D(ALL)%20NOPASSWD%3AALL%0A"
        },
        "mode": 420
      }
    ],
    "filesystems": [
      {
        "device": "/dev/disk/by-partlabel/data",
        "format": "ext4",
        "path": "/var/data"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "# Generated by Butane\n[Unit]\nRequires=systemd-fsck@dev-disk-by\\x2dpartlabel-data.service\nAfter=systemd-fsck@dev-disk-by\\x2dpartlabel-data.service\n\n[Mount]\nWhere=/var/data\nWhat=/dev/disk/by-partlabel/data\nType=ext4\n\n[Install]\nRequiredBy=local-fs.target",
        "enabled": true,
        "name": "var-data.mount"
      },
      {
        "contents": "[Unit]\nDescription=Fetch and deploy target image\n# Only run on the firstboot\nConditionFirstBoot=true\nWants=network-online.target\nAfter=network-online.target\nStartLimitIntervalSec=600\nStartLimitBurst=15\n[Service]\n# This ordering is important\nAfter=coreos-ignition-firstboot-complete.service\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/rpm-ostree rebase --reboot --bypass-driver ostree-unverified-registry:ghcr.io/mbund/homelab\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "rebase.service"
      }
    ]
  }
}
